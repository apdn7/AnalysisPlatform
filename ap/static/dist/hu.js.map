  "ProcDatetimeFormatHoverMsg": "Specifies the datetime format.\n\nFormat\t\t\t\t\tExample\n%%Y-%%m-%%d %%H:%%M:%%S.%%f\t2024-02-21 15:30:51.123\n%%Y-%%m-%%d %%I:%%M:%%S %%p\t2024-02-21 03:30:51 PM\n%%m/%%d/%%y\t\t\t\t 02/21/2024\n%%b %%d, %%Y\t\t\t\t Feb 21, 2024\n%%Y%%m%%d%%H%%M\t\t\t 202409251400\n",
